# Built into the bundle by `vite build` (public by design - VITE_ vars are client-side).
# Must end with /api: api() appends paths like "/generate-token".
# Local `vite dev` ignores this file and keeps using the relative /api Vite proxy.
VITE_API_BASE=https://vehicle-mileage-production-e186.up.railway.app/api
